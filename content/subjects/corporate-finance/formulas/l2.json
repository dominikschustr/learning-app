        "meaning": "correlation between the two assets"
      },
      {
        "symbol": "\\sigma_p",
        "meaning": "volatility of the portfolio"
      },
      {
        "symbol": "x_1,\\ x_2",
        "meaning": "portfolio weights"
      },
      {
        "symbol": "\\sigma_1,\\ \\sigma_2",
        "meaning": "volatilities of the two assets"
      }
    ],
