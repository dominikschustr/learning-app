[
  {
    "id": "f-scenarios",
    "lecture": "l2",
    "name": "Expected return and variance with scenarios",
    "formula": "\\begin{aligned} E(R) &= \\sum_i p_i\\, R_i \\\\[6pt] \\operatorname{Var}(R) &= \\sum_i p_i \\big(R_i - E(R)\\big)^2 \\end{aligned}",
    "use": "Returns given per state of the economy with probabilities.",
    "vars": [
      {
        "symbol": "E(R)",
        "meaning": "expected return"
      },
      {
        "symbol": "\\operatorname{Var}(R)",
        "meaning": "variance of the return"
      },
      {
        "symbol": "p_i",
        "meaning": "probability of state i"
      },
      {
        "symbol": "R_i",
        "meaning": "return in state i"
      }
    ],
    "pitfall": "Weights are the probabilities – no T − 1 here.",
    "sheet": false
  },
  {
    "id": "f-utility",
    "lecture": "l2",
    "name": "Mean–variance utility",
    "formula": "U = E(R) - \\dfrac{\\gamma}{2}\\, \\operatorname{Var}(R)",
    "use": "Ranking investments for a risk-averse investor.",
    "vars": [
      {
        "symbol": "U",
        "meaning": "utility (certainty-equivalent return)"
      },
      {
        "symbol": "E(R)",
        "meaning": "expected return"
      },
      {
        "symbol": "\\gamma",
        "meaning": "risk aversion (higher = more risk-averse)"
      },
      {
        "symbol": "\\operatorname{Var}(R)",
        "meaning": "variance of the return"
      }
    ],
    "pitfall": "Use the variance, not the volatility.",
    "sheet": false
  },
  {
    "id": "f-covariance",
    "lecture": "l2",
    "name": "Covariance",
    "formula": "\\begin{aligned} &\\operatorname{Cov}(R_i, R_j) = \\dfrac{1}{T - 1} \\sum_{t=1}^{T} \\big(R_{i,t} - \\bar{R}_i\\big)\\big(R_{j,t} - \\bar{R}_j\\big) \\\\[10pt] &\\text{scenarios:} \\\\[2pt] &\\operatorname{Cov}(R_i, R_j) = \\sum_s p_s \\big(R_{i,s} - E(R_i)\\big)\\big(R_{j,s} - E(R_j)\\big) \\end{aligned}",
    "use": "How two returns move together (only the sign is easy to read).",
    "vars": [
      {
        "symbol": "\\operatorname{Cov}(R_i, R_j)",
        "meaning": "covariance of the returns of i and j"
      },
      {
        "symbol": "R_{i,t}",
        "meaning": "return of asset i in period t"
      },
      {
        "symbol": "\\bar{R}_i",
        "meaning": "average return of asset i"
      },
      {
        "symbol": "T",
        "meaning": "number of periods"
      },
      {
        "symbol": "p_s",
        "meaning": "probability of scenario s"
      },
      {
        "symbol": "R_{i,s}",
        "meaning": "return of asset i in scenario s"
      },
      {
        "symbol": "E(R_i)",
        "meaning": "expected return of asset i"
      }
    ],
    "pitfall": "Historical data: T − 1, like the variance.",
    "sheet": false
  },
  {
    "id": "f-correlation",
    "lecture": "l2",
    "name": "Correlation",
    "formula": "\\begin{aligned} \\rho_{i,j} &= \\dfrac{\\operatorname{Cov}(R_i, R_j)}{\\sigma_i\\, \\sigma_j} \\\\[8pt] \\Longleftrightarrow\\quad \\operatorname{Cov}(R_i, R_j) &= \\rho_{i,j}\\, \\sigma_i\\, \\sigma_j \\end{aligned}",
    "use": "Strength of comovement on a scale from −1 to +1.",
    "vars": [
      {
        "symbol": "\\rho_{i,j}",
        "meaning": "correlation between i and j (from −1 to +1)"
      },
      {
        "symbol": "\\operatorname{Cov}(R_i, R_j)",
        "meaning": "covariance of the returns"
      },
      {
        "symbol": "\\sigma_i,\\ \\sigma_j",
        "meaning": "volatilities of i and j"
      }
    ],
    "pitfall": "Same sign as the covariance.",
    "sheet": false
  },
  {
    "id": "f-beta",
    "lecture": "l2",
    "name": "Beta",
    "formula": "\\beta_{j,M} = \\dfrac{\\operatorname{Cov}(R_j, R_M)}{\\operatorname{Var}(R_M)} = \\rho_{j,M}\\, \\dfrac{\\sigma_j}{\\sigma_M}",
    "use": "How much a stock moves when the market (or another asset) moves by 1%.",
    "vars": [
      {
        "symbol": "\\beta_{j,M}",
        "meaning": "beta of stock j relative to the market M"
      },
      {
        "symbol": "R_j,\\ R_M",
        "meaning": "returns of stock j and of the market"
      },
      {
        "symbol": "\\rho_{j,M}",
        "meaning": "correlation between j and the market"
      },
      {
        "symbol": "\\sigma_j,\\ \\sigma_M",
        "meaning": "volatilities of j and of the market"
      }
    ],
    "pitfall": "Divide by the variance of the asset that does the moving.",
    "sheet": true
  },
