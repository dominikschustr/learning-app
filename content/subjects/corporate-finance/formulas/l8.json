  {
    "id": "f-convert",
    "lecture": "l8",
    "name": "Converting leverage ratios",
    "formula": "\\begin{aligned} w &= \\dfrac{D}{D + E} \\\\[8pt] \\dfrac{D}{E} &= \\dfrac{w}{1 - w} \\\\[8pt] \\dfrac{E}{D + E} &= \\dfrac{1}{1 + D/E} \\end{aligned}",
    "use": "Whenever the task gives D/(D + E) but the formula needs D/E (or vice versa).",
    "vars": [
      {
        "symbol": "D,\\ E",
        "meaning": "market values of debt and equity"
      },
      {
        "symbol": "w",
        "meaning": "debt ratio D / (D + E)"
      },
      {
        "symbol": "D/E",
        "meaning": "debt-to-equity ratio"
      }
    ],
    "pitfall": "D/(D + E) = 0.5 means D/E = 1.",
