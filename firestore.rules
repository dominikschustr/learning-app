rules_version = '2';

// Regeln für Lernwerk (Konten, Synchronisation, Rangliste, Hervorhebungen, Mitteilungen). Werden bei jedem Push auf main
// automatisch veröffentlicht (.github/workflows/deploy.yml → scripts/deploy-rules.mjs). Siehe README.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Lernstand eines Kontos – nur das Konto selbst kommt heran.
    // v ist die Versionsnummer: jede Änderung muss genau die nächste Version schreiben, sonst war ein
    // anderes Gerät schneller und die App lädt neu und führt zusammen.
    match /progress/{uid} {
      allow get, delete: if isOwner(uid);
      allow create: if isOwner(uid) && validProgress() && request.resource.data.v == 1;
      allow update: if isOwner(uid) && validProgress() && request.resource.data.v == resource.data.v + 1;

      function validProgress() {
        return request.resource.data.keys().hasOnly(['d', 'v'])
          && request.resource.data.d is string
          && request.resource.data.d.size() < 1000000
          && request.resource.data.v is int;
      }
    }

    // Rangliste: Name und Stand jedes Kontos. Alle Angemeldeten sehen alle, ändern nur den eigenen Eintrag.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid) && validUser(request.resource.data);
      allow delete: if isOwner(uid);
    }

    // Hervorhebungen: Fragen, die ein Konto für seine Lerngruppe markiert hat („Dominik hat die Frage hervorgehoben“).
    // Alle Angemeldeten sehen alle, ändern nur die eigenen. items = Schlüssel der Fragen (wie die Lesezeichen).
    match /highlights/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid) && validHighlights(request.resource.data);
      allow delete: if isOwner(uid);
    }

    function validHighlights(h) {
      return h.keys().hasOnly(['name', 'items', 'at'])
        && h.name is string && h.name.size() >= 1 && h.name.size() <= 24
        && h.items is list && h.items.size() <= 2000
        && h.at == request.time;
    }

    // Mitteilungen (Web Push): Push-Abo eines Geräts (id = Hash des Endpoints). Lesen kann es kein Konto –
    // nur der Versand-Workflow mit Dienstkonto (umgeht die Regeln). Schreiben nur für sich selbst; ein Gerät
    // darf sein Abo einem anderen Konto übergeben (Kontowechsel). sent setzt nur der Workflow.
    // daily = Erinnerung ans Tagesziel, social = Mitteilung, wenn jemand aus der Rangliste lernt (beide optional).
    // notify/* (Zustand des Versand-Workflows) hat keine Regel und ist damit für alle Konten gesperrt.
    match /push/{id} {
      allow create: if validPush(request.resource.data) && !('sent' in request.resource.data);
      allow update: if validPush(request.resource.data)
        && (!('sent' in resource.data) || request.resource.data.sent == resource.data.sent);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    function validPush(p) {
      return signedIn()
        && p.keys().hasOnly(['uid', 'sub', 'hour', 'tz', 'daily', 'social', 'at', 'sent'])
        && p.uid == request.auth.uid
        && (!('daily' in p) || p.daily is bool)
        && (!('social' in p) || p.social is bool)
        && p.sub is string && p.sub.size() >= 10 && p.sub.size() <= 4000
        && p.hour is int && p.hour >= 0 && p.hour <= 23
        && p.tz is string && p.tz.size() >= 1 && p.tz.size() <= 64
        && p.at == request.time;
    }

    function isDay(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validUser(e) {
      // weekXp/week (Wochenliga) sind optional, damit ältere App-Versionen weiter melden können
      return e.keys().hasOnly(['name', 'xp', 'today', 'day', 'goal', 'streak', 'streakDay', 'weekXp', 'week', 'at'])
        && e.name is string && e.name.size() >= 1 && e.name.size() <= 24
        && e.xp is int && e.xp >= 0 && e.xp <= 10000000
        && e.today is int && e.today >= 0 && e.today <= 100000
        && isDay(e.day)
        && e.goal is int && e.goal >= 1 && e.goal <= 1000
        && e.streak is int && e.streak >= 0 && e.streak <= 100000
        && (e.streakDay == null || isDay(e.streakDay))
        && (!('weekXp' in e) || (e.weekXp is int && e.weekXp >= 0 && e.weekXp <= 10000000))
        && (!('week' in e) || e.week == null || isDay(e.week))
        && e.at == request.time;
    }
  }
}
